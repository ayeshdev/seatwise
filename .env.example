# Local development settings for docker compose. Copy to .env to override.
# Every value here is a DEV-ONLY default; production values live in Dokploy.

# Host ports (chosen to avoid clashing with other local stacks)
DESK_PORT=4280
API_PORT=8280
IDP_PORT=8281
DB_PORT=5442
SEARCH_PORT=7710

# Database
DB_USER=seatwise
DB_PASSWORD=seatwise
KEYCLOAK_DB_PASSWORD=keycloak

# Keycloak master-realm admin (ops console at http://localhost:8281/admin)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Client secret the API uses to manage staff users in Keycloak
SEATWISE_PROVISIONER_SECRET=dev-provisioner-secret
# Local-only password grant client for curl probing; keep false anywhere public
SEATWISE_DEV_TOOLS_ENABLED=true

# Meilisearch master key (the API derives a scoped key from it at startup)
SEATWISE_SEARCH_MASTER_KEY=dev-search-master-key-change-me

# API
API_PROFILES=dev,demo
SEATWISE_CENTRE_TIMEZONE=Europe/London

# First Admin, created on first start when no active Admin exists
SEATWISE_BOOTSTRAP_ADMIN_EMAIL=admin@seatwise.local
SEATWISE_BOOTSTRAP_ADMIN_PASSWORD=Admin#Seatwise1
SEATWISE_BOOTSTRAP_PASSWORD_TEMPORARY=false

# Demo accounts (demo profile only): manager@seatwise.local, staff@seatwise.local
SEATWISE_DEMO_MANAGER_PASSWORD=Manager#Seatwise1
SEATWISE_DEMO_STAFF_PASSWORD=Staff#Seatwise1
